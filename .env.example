# ===================================
# BACKEND CONFIGURATION (Spring Boot)
# ===================================
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bookdb
DB_USERNAME=root
DB_PASSWORD=your_db_password
DB_URL=jdbc:mysql://localhost:3306/bookdb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JPA / Hibernate Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# Security / JWT (Optional for future auth setup)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRATION_MS=86400000

# ===================================
# FRONTEND CONFIGURATION (Vite React)
# ===================================
VITE_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_TITLE="Book Management System"
