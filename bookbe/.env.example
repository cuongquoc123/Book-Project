# Backend Server Settings
SERVER_PORT=8080

# Database Settings (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bookdb
DB_USERNAME=root
DB_PASSWORD=your_db_password
DB_URL=jdbc:mysql://localhost:3306/bookdb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JPA / Hibernate Settings
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# JWT Settings
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRATION_MS=86400000
google_client_id = 12321312312.apps.googleusercontent.com

# Rate Limiting Settings (time in seconds)
RATE_LIMIT_TOKEN_MAX_REQUESTS=60
RATE_LIMIT_TOKEN_WINDOW_SECONDS=60
RATE_LIMIT_IP_MAX_REQUESTS=100
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_REFRESH_MAX_REQUESTS=3
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_IP_BLOCK_SECONDS=1800